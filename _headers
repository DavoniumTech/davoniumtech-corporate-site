# HTML/extensionless routes revalidate; the more specific static-asset rules below assign longer caching.
/*
  Cache-Control: no-cache, must-revalidate

/
  Cache-Control: no-cache, must-revalidate

/*.html
  Cache-Control: no-cache, must-revalidate

# Versioned asset URLs use ?v=N; increase that version whenever changing the file.
/assets/icons/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800

/assets/images/design-concepts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/images/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800

/assets/social/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800

/assets/css/*
  Cache-Control: public, max-age=31536000, immutable

/assets/js/*
  Cache-Control: public, max-age=31536000, immutable

/404.html
  X-Robots-Tag: noindex, follow

/offline.html
  X-Robots-Tag: noindex, follow

/legal/*
  X-Robots-Tag: noindex, follow

https://:version.:subdomain.workers.dev/*
  X-Robots-Tag: noindex

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Service-Worker-Allowed: /

/demos/certificates/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800

/assets/images/flyers/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800

/docs/media/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800
